# Image pins. Keep exact versions; do not use latest in production.
GRAFANA_VERSION=13.0.1
LOKI_VERSION=3.7.0
ALLOY_VERSION=v1.16.0

# Grafana public URL and first admin account.
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-use-a-long-random-password
GRAFANA_LOG_LEVEL=info

# Loki S3-compatible object storage. Required for production.
LOKI_S3_BUCKET=loki-logs
LOKI_S3_ENDPOINT=s3.example.com
LOKI_S3_REGION=us-east-1
LOKI_S3_ACCESS_KEY_ID=change-me
LOKI_S3_SECRET_ACCESS_KEY=change-me
LOKI_S3_FORCE_PATH_STYLE=true
LOKI_S3_INSECURE=false

# Loki retention and ingest/query controls.
LOKI_LOG_LEVEL=info
LOKI_RETENTION_PERIOD=720h
LOKI_INGESTION_RATE_MB=16
LOKI_INGESTION_BURST_SIZE_MB=32
LOKI_MAX_QUERY_SERIES=5000
LOKI_MAX_ENTRIES_LIMIT_PER_QUERY=5000
LOKI_QUERY_TIMEOUT=2m
LOKI_MAX_QUERY_LOOKBACK=720h
LOKI_REJECT_OLD_SAMPLES_MAX_AGE=168h
LOKI_CHUNK_IDLE_PERIOD=30m
LOKI_MAX_CHUNK_AGE=2h
LOKI_CHUNK_TARGET_SIZE=1572864
LOKI_TSDB_CACHE_TTL=24h
LOKI_COMPACTION_INTERVAL=10m
LOKI_RETENTION_DELETE_DELAY=2h
LOKI_RETENTION_DELETE_WORKER_COUNT=50

# Optional Alloy profile.
ALLOY_LOG_LEVEL=info
ALLOY_ENVIRONMENT=production

# Docker log rotation for this stack's own containers.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Resource defaults. Tune these per host in Coolify or .env.
GRAFANA_CPU_LIMIT=1.00
GRAFANA_CPU_RESERVATION=0.25
GRAFANA_MEMORY_LIMIT=512M
GRAFANA_MEMORY_RESERVATION=256M

LOKI_CPU_LIMIT=2.00
LOKI_CPU_RESERVATION=0.50
LOKI_MEMORY_LIMIT=1G
LOKI_MEMORY_RESERVATION=512M

ALLOY_CPU_LIMIT=1.00
ALLOY_CPU_RESERVATION=0.25
ALLOY_MEMORY_LIMIT=512M
ALLOY_MEMORY_RESERVATION=256M

# Local-only override ports used with compose.local.yaml.
GRAFANA_LOCAL_PORT=3000
LOKI_LOCAL_PORT=3100
ALLOY_UI_LOCAL_PORT=12345
ALLOY_OTLP_GRPC_LOCAL_PORT=4317
ALLOY_OTLP_HTTP_LOCAL_PORT=4318
